---
import { Image } from 'astro:assets'

import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
// 你自己的收款码：把真实图片覆盖到仓库根目录的 qr/ 下（文件名别改）
import alipayQr from '../../../qr/alipay.png'
import wechatQr from '../../../qr/wx.png'

const headings = [
  { depth: 2, slug: 'programs', text: '项目' },
  { depth: 2, slug: 'sponsorship', text: '打赏' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>GitHub 提交记录：</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/chitorio'
      format='svg'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  <!-- <p>
    这里是我写过的项目和代码，主要是 C++ 和 Python，方向偏机器人、计算机视觉，还有一些课程里做的东西。
  </p> -->
  <Button title='请我喝杯奶茶' class='w-fit' href='#sponsorship'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button>

  <h2 id='programs'>项目</h2>
  <ProjectSection
    projects={[
      {
        name: '🤖 XJTU-RMV',
        description:
          'RoboMaster 战队视觉组培训任务：从 Ubuntu 环境搭建、OpenCV 图像处理到装甲板识别，C++ / CMake',
        links: [{ type: 'github', href: 'https://github.com/chitorio/XJTU-RMV' }]
      },
      {
        name: '🚄 TrafficSystem',
        description:
          '城际交通查询系统：C++ 后端以图结构存城市与班次并提供 HTTP 接口，Vue 3 前端配百度地图展示路线',
        links: [{ type: 'github', href: 'https://github.com/chitorio/TrafficSystem' }]
      }
    ]}
  />

  <h2 id='sponsorship'>打赏</h2>
  <p>
    如果这个博客或者我写的文章对你有帮助，可以扫码请我喝杯奶茶 ☕。你的支持会让我更有动力继续写下去。
  </p>
  <Sponsorship
    methods={[
      { name: '微信', icon: 'wechat-pay', image: wechatQr },
      { name: '支付宝', icon: 'alipay', image: alipayQr }
    ]}
  />
  <p>
    打赏后想让我知道是谁，可以发邮件到
    <a href='mailto:so487193026@foxmail.com'>so487193026@foxmail.com</a>，或者直接在评论区留言。
  </p>
  {/* 想要展示赞助者名单时，取消下面注释并把名单换成真实数据（组件在 @/components/projects/Sponsors.astro）
  <Sponsors progressMax={50} sponsors={[{ name: '张三', platform: '微信', amount: 10, date: '2026-09-14' }]} />
  */}
</PageLayout>
